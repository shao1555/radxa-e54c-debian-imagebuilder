# E54C サーバー OS 用 config fragment (defconfig に重ねる)
# scripts/build-kernel.sh が scripts/kconfig/merge_config.sh で適用する

# --- E54C のネットワーク (GMAC + RTL8367RB DSA) ---
CONFIG_STMMAC_ETH=y
# DWMAC_ROCKCHIP は STMMAC_PLATFORM=m に依存し y にはできない (m = initramfs から読込)
CONFIG_DWMAC_ROCKCHIP=m
CONFIG_NET_DSA=m
CONFIG_NET_DSA_REALTEK=m
# MDIO/SMI インターフェース選択は bool (=m にすると olddefconfig に落とされて
# スイッチが丸ごと無効になる。実測でハマった点)
CONFIG_NET_DSA_REALTEK_MDIO=y
CONFIG_NET_DSA_REALTEK_SMI=y
CONFIG_NET_DSA_REALTEK_RTL8365MB=m
CONFIG_NET_DSA_TAG_RTL8_4=m

# --- コンテナ (incus / lxc / k3s) ---
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_OVERLAY_FS=m
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_XZ=y
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VLAN_8021Q=m
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_VXLAN=m
CONFIG_WIREGUARD=m
CONFIG_TUN=m

# --- OpenWrt コンテナの firewall4 / k8s の kube-proxy が使う netfilter 一式 ---
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_COMPAT=m
# NFT_FIB_INET は NFT_FIB_IPV4/IPV6 の両方に依存する (欠けると黙って落ちる。実測)
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m
# firewall4 (OpenWrt) の標準 ruleset が使う expression 群。
# NFT_LIMIT が無いと syn-flood チェーンのロードに失敗する (レビュー指摘)。
# OpenWrt の kmod-nft-core / kmod-nft-nat の同梱セットに合わせる
CONFIG_NFT_LIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_NUMGEN=m
CONFIG_NFT_HASH=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_STATISTIC=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_IP_VS=m
CONFIG_IP_VS_RR=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP6_NF_IPTABLES=m

# --- ストレージ (M.2 NVMe / microSD / k8s 向け) ---
CONFIG_BLK_DEV_NVME=y
CONFIG_MMC=y
# m 要求 (initramfs でロードされる)。debian ベースでは依存 MMC_SDHCI_PLTFM=m の
# ため y にできない。defconfig ベースでは y になる (検証は m 要求に y も合格)
CONFIG_MMC_SDHCI_OF_DWCMSHC=m
CONFIG_DM_THIN_PROVISIONING=m
CONFIG_DM_SNAPSHOT=m
CONFIG_BTRFS_FS=m

# --- セキュリティ (Incus の隔離・OpenWrt コンテナの閉じ込めに AppArmor を使う) ---
# LSM リストには対応する Kconfig を有効化したものだけを載せる (無効なものは no-op)
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_AUDIT=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_LSM="landlock,lockdown,yama,integrity,apparmor"

# --- デバッグ情報は生成しない (dbg パッケージ ~500MiB の生成防止 + ビルド短縮) ---
CONFIG_DEBUG_INFO_NONE=y

# --- 監視・デバッグ ---
CONFIG_TASKSTATS=y
CONFIG_TASK_DELAY_ACCT=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y
CONFIG_PSI=y
