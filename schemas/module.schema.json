{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shao1555/radxa-e54c-debian-imagebuilder/schemas/module.schema.json",
  "title": "Module (e54c.image/v1alpha1)",
  "description": "modules/<id>/module.yaml の構造検証。ファイル実在・実行ビット・symlink・containment・overlay 競合は Resolver の semantic validation が行う",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata"],
  "properties": {
    "apiVersion": { "const": "e54c.image/v1alpha1" },
    "kind": { "const": "Module" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/moduleId" },
        "description": { "type": "string" }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apt": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9+.-]+(/[a-z0-9-]+)?$" }
        }
      }
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source"],
        "properties": {
          "source": { "$ref": "#/$defs/relativePath" },
          "target": { "type": "string" }
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rootfs.customize": { "$ref": "#/$defs/scriptList" },
        "rootfs.seal": { "$ref": "#/$defs/scriptList" },
        "image.finalize": { "$ref": "#/$defs/scriptList" },
        "runtime.firstBoot": { "$ref": "#/$defs/scriptList" }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rootfs": { "$ref": "#/$defs/scriptList" },
        "boot": { "$ref": "#/$defs/scriptList" },
        "hardware": { "$ref": "#/$defs/scriptList" }
      }
    }
  },
  "$defs": {
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[^\\u0000\\r\\n]+$"
    },
    "scriptList": {
      "type": "array",
      "items": { "$ref": "#/$defs/relativePath" }
    }
  }
}
